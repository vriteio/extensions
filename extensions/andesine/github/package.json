{
  "name": "andesine-github",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "andesine extensions build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:sync": "tsx scripts/check-sync.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@andesine/converters": "0.8.1",
    "@andesine/extensions": "0.8.0",
    "@andesine/sdk": "0.8.0",
    "solid-js": "^1.9.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.1.2",
    "andesine": "0.8.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
