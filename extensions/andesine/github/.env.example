# Local values for `npm run backend` (wrangler dev); in production, use `wrangler secret put`.
# The private key from `andesine extensions keys generate` (a JSON Web Key on one line)
ANDESINE_EXTENSION_KEY=
# The local instance's API URL
ANDESINE_INSTANCES=http://localhost:3333
# The GitHub App: its private key (PEM, with \n for line breaks), OAuth client, and webhook secret
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Signs install states and storage records: 32 or more random characters
STATE_SECRET=
# Development: a fixed ngrok domain for the GitHub App's URLs, e.g. my-app.ngrok-free.app; without
# it, `npm run tunnel` uses a cloudflared quick tunnel, whose URL changes on each start
TUNNEL_DOMAIN=
