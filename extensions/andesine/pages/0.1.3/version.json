    "styles": {
      "url": "https://extensions.andesine.app/extensions/andesine/pages/0.1.3/styles.css",
      "sha256": "75572a3ed16b057bc0bee4f0e944e0bbf0601ea0371aebd38cfb2719b9ceed12",
      "size": 34035
    },
    "icons": {
      "url": "https://extensions.andesine.app/extensions/andesine/pages/0.1.3/icons.css",
      "sha256": "e1a0ea01a38018604786e8b688f3f9e932de99dc1a8664c7c7bca1f1bce7087e",
