{
  "manifest": {
    "name": "andesine/pages",
    "version": "0.1.3",
    "displayName": "Andesine Pages",
    "description": "Hosts documentation sites for collections, and edits the content components of Andesine Pages sites.",
    "icon": "i-pages:logo?bg",
    "apiVersion": 1,
    "permissions": [
      "read:collections",
      "read:publishing",
      "publishable-keys",
      "ai-answers"
    ],
    "requests": [],
    "backend": {
      "url": "https://pages.extensions.andesine.app",
      "keys": [
        {
          "kid": "key-2026-10-12",
          "kty": "OKP",
          "alg": "EdDSA",
          "crv": "Ed25519",
          "x": "CDotjwSSau5mni50IqyzuMBo3ljdCJ1MEhiEs6BBTn8"
        }
      ]
    },
    "webhooks": {
      "lifecycle": {
        "events": [
          "extension.uninstalled"
        ],
        "path": "/andesine/webhooks",
        "channels": []
      },
      "publishing": {
        "events": [
          "publishing.channel_advanced"
        ],
        "path": "/andesine/webhooks",
        "channels": []
      }
    },
    "elementViews": [
      {
        "id": "callout",
        "name": "Callout",
        "description": "A note, tip, warning, or danger box",
        "icon": "i-lucide:info",
        "element": "Callout",
        "view": "CalloutView",
        "content": true,
        "accepts": {
          "blocks": [
            "paragraph"
          ]
        },
        "props": [
          {
            "name": "type",
            "title": "Type",
            "type": "string",
            "enum": [
              "note",
              "tip",
              "warning",
              "danger"
            ],
            "control": "toggle",
            "default": "note"
          },
          {
            "name": "title",
            "title": "Title",
            "type": "string",
            "placeholder": "Optional"
          }
        ],
        "children": []
      },
      {
        "id": "card",
        "name": "Card",
        "description": "A card with a title, an optional link, and an icon",
        "icon": "i-lucide:square",
        "element": "Card",
        "view": "CardView",
        "content": true,
        "accepts": {
          "blocks": [
            "paragraph"
          ]
        },
        "props": [
          {
            "name": "title",
            "title": "Title",
            "type": "string",
            "minLength": 1,
            "default": "Title"
          },
          {
            "name": "icon",
            "title": "Icon",
            "type": "string",
            "control": "icon"
          },
          {
            "name": "href",
            "title": "Link",
            "type": "string",
            "control": "link"
          }
        ],
        "children": []
      },
      {
        "id": "card-grid",
        "name": "Card grid",
        "description": "Cards side by side",
        "icon": "i-lucide:layout-grid",
        "element": "CardGrid",
        "view": "CardGridView",
        "content": true,
        "accepts": {
          "elements": [
            "Card"
          ]
        },
        "children": []
      },
      {
        "id": "accordion",
        "name": "Accordion",
        "description": "Content shown when its title is opened",
        "icon": "i-lucide:chevrons-up-down",
        "element": "Accordion",
        "view": "AccordionView",
        "content": true,
        "rejects": {
          "elements": [
            "Accordion"
          ]
        },
        "props": [
          {
            "name": "title",
            "title": "Title",
            "type": "string",
            "minLength": 1,
            "default": "Details"
          },
          {
            "name": "open",
            "title": "Open on load",
            "type": "boolean"
          }
        ],
        "children": []
      },
      {
        "id": "figure",
        "name": "Figure",
        "description": "An image or other content with a caption",
        "icon": "i-lucide:image",
        "element": "Figure",
        "view": "FigureView",
        "content": true,
        "rejects": {
          "elements": [
            "Figure"
          ]
        },
        "props": [
          {
            "name": "caption",
            "title": "Caption",
            "type": "string",
            "minLength": 1,
            "default": "Caption"
          }
        ],
        "children": []
      },
      {
        "id": "steps",
        "name": "Steps",
        "description": "Numbered steps with titles",
        "icon": "i-lucide:list-ordered",
        "element": "Steps",
        "view": "StepsView",
        "content": true,
        "accepts": {
          "elements": [
            "Step"
          ]
        },
        "children": [
          {
            "element": "Step",
            "name": "Step",
            "description": "A step of the steps it's in",
            "icon": "i-lucide:circle-dot",
            "props": [
              {
                "name": "title",
                "title": "Title",
                "type": "string",
                "minLength": 1,
                "default": "Step"
              }
            ]
          }
        ]
      },
      {
        "id": "file-tree",
        "name": "File tree",
        "description": "Files and folders",
        "icon": "i-lucide:folder-tree",
        "element": "FileTree",
        "view": "FileTreeView",
        "content": true,
        "accepts": {
          "elements": [
            "Folder",
            "File"
          ]
        },
        "children": [
          {
            "element": "Folder",
            "name": "Folder",
            "description": "A folder in a file tree",
            "icon": "i-lucide:folder",
            "accepts": {
              "elements": [
                "Folder",
                "File"
              ]
            },
            "props": [
              {
                "name": "name",
                "title": "Name",
                "type": "string",
                "minLength": 1,
                "default": "folder"
              }
            ]
          },
          {
            "element": "File",
            "name": "File",
            "description": "A file in a file tree",
            "icon": "i-lucide:file",
            "content": false,
            "props": [
              {
                "name": "name",
                "title": "Name",
                "type": "string",
                "minLength": 1,
                "default": "file.ts"
              }
            ]
          }
        ]
      },
      {
        "id": "tabs",
        "name": "Tabs",
        "description": "Content in tabs",
        "icon": "i-lucide:panels-top-left",
        "element": "Tabs",
        "view": "TabsView",
        "content": true,
        "accepts": {
          "elements": [
            "Tab"
          ]
        },
        "props": [
          {
            "name": "syncKey",
            "title": "Sync key",
            "description": "Tabs with the same key switch together on a page",
            "type": "string"
          }
        ],
        "children": [
          {
            "element": "Tab",
            "name": "Tab",
            "description": "A tab of the tabs it's in",
            "icon": "i-lucide:square-dashed",
            "rejects": {
              "elements": [
                "Tabs"
              ]
            },
            "props": [
              {
                "name": "label",
                "title": "Label",
                "type": "string",
                "minLength": 1,
                "default": "Tab"
              }
            ]
          }
        ]
      },
      {
        "id": "code-group",
        "name": "Code group",
        "description": "Code blocks shown as tabs",
        "icon": "i-lucide:code",
        "element": "CodeGroup",
        "view": "CodeGroupView",
        "content": true,
        "accepts": {
          "blocks": [
            "codeBlock"
          ]
        },
        "children": []
      },
      {
        "id": "visibility",
        "name": "Visibility",
        "description": "Content only for the web page, or only for agents",
        "icon": "i-lucide:eye",
        "element": "Visibility",
        "view": "VisibilityView",
        "content": true,
        "rejects": {
          "elements": [
            "Visibility"
          ]
        },
        "props": [
          {
            "name": "for",
            "title": "Shown to",
            "type": "string",
            "enum": [
              "humans",
              "agents"
            ],
            "control": "toggle",
            "default": "humans"
          }
        ],
        "children": []
      }
    ],
    "blockActions": [],
    "panels": [
      {
        "id": "site",
        "name": "Andesine Pages",
        "icon": "i-lucide:globe",
        "side": "right",
        "context": "collection",
        "view": "SitePanel"
      }
    ],
    "pages": [
      {
        "id": "site-setup",
        "name": "Setup",
        "icon": "i-lucide:globe",
        "context": "collection",
        "highlightContext": true,
        "when": {
          "publishing": true,
          "storage": {
            "key": "site:{publishingCollectionID}",
            "exists": false
          }
        },
        "view": "SiteSetupPage"
      },
      {
        "id": "site-settings",
        "name": "Site",
        "icon": "i-lucide:globe",
        "context": "collection",
        "highlightContext": true,
        "when": {
          "storage": {
            "key": "site:{publishingCollectionID}",
            "exists": true
          }
        },
        "view": "SitePage"
      },
      {
        "id": "site-general",
        "name": "General",
        "icon": "i-lucide:settings",
        "context": "collection",
        "parent": "site-settings",
        "when": {
          "storage": {
            "key": "site:{publishingCollectionID}",
            "exists": true
          }
        },
        "view": "SiteGeneralPage"
      },
      {
        "id": "site-appearance",
        "name": "Appearance",
        "icon": "i-lucide:palette",
        "context": "collection",
        "parent": "site-settings",
        "when": {
          "storage": {
            "key": "site:{publishingCollectionID}",
            "exists": true
          }
        },
        "view": "SiteAppearancePage"
      },
      {
        "id": "site-navigation",
        "name": "Navigation",
        "icon": "i-lucide:panel-top",
        "context": "collection",
        "parent": "site-settings",
        "when": {
          "storage": {
            "key": "site:{publishingCollectionID}",
            "exists": true
          }
        },
        "view": "SiteNavigationPage"
      },
      {
        "id": "site-content",
        "name": "Content and AI",
        "icon": "i-lucide:sparkles",
        "context": "collection",
        "parent": "site-settings",
        "when": {
          "storage": {
            "key": "site:{publishingCollectionID}",
            "exists": true
          }
        },
        "view": "SiteContentPage"
      },
      {
        "id": "site-domains",
        "name": "Domains",
        "icon": "i-lucide:link",
        "context": "collection",
        "parent": "site-settings",
        "when": {
          "storage": {
            "key": "site:{publishingCollectionID}",
            "exists": true
          }
        },
        "view": "SiteDomainsPage"
      },
      {
        "id": "site-builds",
        "name": "Builds",
        "icon": "i-lucide:hammer",
        "context": "collection",
        "parent": "site-settings",
        "when": {
          "storage": {
            "key": "site:{publishingCollectionID}",
            "exists": true
          }
        },
        "view": "SiteBuildsPage"
      }
    ]
  },
  "sourceCommit": "b48d5b181b4780861561f3749766e2cd266d3426",
