{
  "name": "andesine-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "andesine extensions build",
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy",
    "deploy:sites": "wrangler deploy -c wrangler.sites.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/backend && tsc --noEmit -p src/sites",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@andesine/extensions": "0.8.0",
    "@andesine/sdk": "0.8.0",
    "clsx": "^2.1.1",
    "solid-js": "^1.9.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.0",
    "@eslint/js": "^10.0.1",
    "andesine": "0.8.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "wrangler": "^4.40.0"
  }
}
