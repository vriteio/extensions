# The backend's environment for `npm run dev` and `npm run backend` (wrangler dev). `npm run dev`
# creates `.env` from this file and fills it in; in production, use `wrangler secret put` and the
# vars in wrangler.jsonc.
# The private key from `andesine extensions keys generate`; `andesine extensions dev` writes a development key.
ANDESINE_EXTENSION_KEY=
# API URLs of the trusted Andesine instances, separated by commas; `andesine extensions dev` adds its instance.
ANDESINE_INSTANCES=
# Signs the backend's storage records: 32 or more random characters (`npm run dev` generates one).
STATE_SECRET=
SITES_DOMAIN=localhost
SITES_FALLBACK_HOST=localhost
# Development only: sites are http://<subdomain>.localhost:<port>, served by the sites Worker.
SITES_DEV_PORT=8788
# Development only: builds go to the local build server in place of containers.
LOCAL_BUILD_SERVER=http://localhost:8080
